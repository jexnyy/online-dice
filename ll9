```html
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cadmus Malaf</title>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
}

body{
font-family:'Poppins',sans-serif;
background:linear-gradient(135deg,#0a0a0a,#2b0000,#5c0000,#120000);
background-size:400% 400%;
animation:bgMove 12s ease infinite;
color:white;
min-height:100vh;
padding:40px 20px;
overflow-x:hidden;
}

@keyframes bgMove{
0%{background-position:0% 50%;}
50%{background-position:100% 50%;}
100%{background-position:0% 50%;}
}

.container{
max-width:1300px;
margin:auto;
}

.title{
text-align:center;
font-family:'Cinzel',serif;
font-size:5rem;
font-weight:700;
letter-spacing:5px;
margin-bottom:15px;
text-shadow:0 0 25px rgba(255,0,0,0.7);
}

.subtitle{
text-align:center;
font-size:1.3rem;
color:#ffb3b3;
margin-bottom:50px;
}

.gallery{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
gap:35px;
}

.card{
background:rgba(255,255,255,0.05);
border:2px solid rgba(255,0,0,0.3);
border-radius:25px;
overflow:hidden;
backdrop-filter:blur(8px);
box-shadow:0 10px 35px rgba(0,0,0,0.5);
transition:0.4s ease;
animation:fadeUp 1s ease;
}

.card:hover{
transform:translateY(-10px) scale(1.03);
box-shadow:0 15px 45px rgba(255,0,0,0.5);
}

.card img{
width:100%;
height:500px;
object-fit:cover;
display:block;
}

.card-text{
padding:20px;
text-align:center;
}

.card-text h2{
font-size:2rem;
margin-bottom:10px;
color:#ff4d4d;
}

.card-text p{
font-size:1rem;
line-height:1.6;
color:#f0dada;
}

@keyframes fadeUp{
0%{
opacity:0;
transform:translateY(40px);
}
100%{
opacity:1;
transform:translateY(0);
}
}

.footer{
margin-top:60px;
text-align:center;
font-size:1rem;
color:#ff9999;
}

@media(max-width:768px){
.title{
font-size:3rem;
}

.card img{
height:380px;
}
}
</style>
</head>
<body>

<div class="container">

<h1 class="title">Cadmus Malaf</h1>
<p class="subtitle">Dark Red Gallery Experience</p>

<div class="gallery">

<div class="card">
<img src="./Screenshot 2026-05-19 185751(1).png" alt="Cadmus Image 1">
</div>

<div class="card">
<img src="./Screenshot 2026-05-19 185758(1).png" alt="Cadmus Image 2">
</div>

<div class="card">
<img src="c:\Users\Dell\Pictures\Screenshots\image3.png.png" alt="Cadmus Image 3">
</div>

</div>

<div class="footer">
Cadmus Malaf © 2026
</div>

</div>

</body>
</html>
